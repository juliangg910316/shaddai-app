rules_version = '2';

// Reglas de seguridad de Firestore de Studio Shaddai.
//
// - settings/priceList: definitivas (spec 004, RNF-2).
// - users, appointments y busySlots: las de la reserva (spec 005, plan § 2),
//   la edición del turno por la clienta (spec 006, plan § 2) y la reserva
//   de la admin para otra persona (spec 007, plan § 2), y su edición de los
//   turnos (spec 008, plan § 2). La clienta cancela su turno activo y copia
//   a él su WhatsApp nuevo (spec 009, plan § 3). Las fichas no se borran
//   desde la app: solo la función deleteAccount, con el SDK de
//   administración (spec 009, RF-42). Los solapes con otros turnos o con
//   cierres y un segundo turno activo los comprueba la app antes de
//   guardar; las reglas que los impiden llegan en la spec 012.
// - closures: los cierres de la agenda (spec 008, RF-42).
// - settings/calendar: lo lee cualquiera con sesión y solo lo escribe la
//   admin (spec 006, RF-25; adelanta esa parte de la spec 012), con el
//   margen de edición como entero >= 0 (spec 008, RF-44).
//
// Lo que no aparece aquí queda denegado. Se comprueban a mano en el
// simulador de la consola: specs/004-servicios-firestore/rules-check.md,
// specs/005-reservas/rules-check.md, specs/006-editar-turno/rules-check.md,
// specs/007-reserva-admin/rules-check.md,
// specs/008-agenda-admin/rules-check.md y
// specs/009-perfil/rules-check.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // La ficha de la usuaria con sesión.
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // La admin tiene el rol 'admin' en su ficha (se asigna a mano).
    function isAdmin() {
      return request.auth != null && myProfile().role == 'admin';
    }

    function isBlocked() {
      return myProfile().get('isBlocked', false) == true;
    }

    // Margen de edición del salón (spec 006, RF-21): 0 si no hay documento
    // o campo.
    function editMarginMinutes() {
      let path = /databases/$(database)/documents/settings/calendar;
      return exists(path) ? get(path).data.get('editMarginMinutes', 0) : 0;
    }

    // El margen que se escribe en el calendario, si está: minutos enteros,
    // 0 o más (spec 008, RF-44).
    function validEditMargin() {
      let data = request.resource.data;
      return !('editMarginMinutes' in data)
        || (data.editMarginMinutes is int && data.editMarginMinutes >= 0);
    }

    // Lista de precios: la ve cualquiera, también sin sesión; solo la admin
    // la crea (carga inicial) y la cambia; el documento nunca se borra.
    match /settings/priceList {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Fichas (RF-57): cada una lee y cambia la suya, sin tocar su rol ni su
    // bloqueo; la admin las lee y cambia todas. Nadie las borra.
    match /users/{userId} {
      allow get, list: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.get('role', 'cliente') == 'cliente'
        && request.resource.data.get('isBlocked', false) == false;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBlocked']));
      allow delete: if false;
    }

    // Turnos: la clienta solo ve los suyos (RF-53) y los crea a su nombre,
    // sin estar bloqueada (RF-54) y con su turno ocupado en el mismo lote,
    // con las mismas horas. La admin solo cambia el estado (RF-55, RF-56).
    // La clienta edita su turno activo fuera del margen de edición: solo el
    // inicio, el fin y lo reservado; vuelve a esperar confirmación y su turno
    // ocupado cambia a la vez, con las mismas horas (spec 006, RF-24, RF-26).
    // "Activo" queda cubierto: si empieza después de ahora más el margen,
    // aún no ha terminado.
    //
    // La clienta no puede marcar su turno como creado por la admin. La admin
    // agenda turnos confirmados y marcados para una persona sin cuenta
    // (clientId nulo) o para una clienta sin bloquear que no es ella, con su
    // turno ocupado en el mismo lote (spec 007, RF-2, RF-25). Un turno sin
    // cuenta no coincide con el uid de nadie: solo lo lee la admin (RF-26).
    // La edición de la clienta no puede tocar la marca (RF-30).
    //
    // La admin edita un turno activo de otra persona (spec 008, RF-43): la
    // persona, las horas y lo reservado, siempre confirmado y con su turno
    // ocupado a la vez. No quita la marca; si cambia la persona, lo marca. La
    // persona es válida como al agendar (spec 007).
    //
    // La clienta cancela su turno activo fuera del margen, también si está
    // bloqueada: solo el estado y quién lo canceló, y su turno ocupado se
    // borra en el mismo lote (spec 009, RF-19). Al cambiar su WhatsApp, lo
    // copia a su turno activo, igual al de su ficha tras el lote (RF-28).
    match /appointments/{id} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.clientId == request.auth.uid);
      allow create: if (signedIn() && !isBlocked()
          && request.resource.data.clientId == request.auth.uid
          && request.resource.data.status == 'waiting_confirmation'
          && request.resource.data.get('createdByAdmin', false) == false
          && request.resource.data.endTime > request.resource.data.startTime
          && getAfter(/databases/$(database)/documents/busySlots/$(id)).data.start == request.resource.data.startTime
          && getAfter(/databases/$(database)/documents/busySlots/$(id)).data.end == request.resource.data.endTime)
        || (isAdmin()
          && request.resource.data.status == 'confirmed'
          && request.resource.data.createdByAdmin == true
          && request.resource.data.endTime > request.resource.data.startTime
          && getAfter(/databases/$(database)/documents/busySlots/$(id)).data.start == request.resource.data.startTime
          && getAfter(/databases/$(database)/documents/busySlots/$(id)).data.end == request.resource.data.endTime
          && (request.resource.data.clientId == null
            || (request.resource.data.clientId != request.auth.uid
              && get(/databases/$(database)/documents/users/$(request.resource.data.clientId)).data.role == 'cliente'
              && get(/databases/$(database)/documents/users/$(request.resource.data.clientId)).data.get('isBlocked', false) == false)));
      allow update: if
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        // La clienta edita su turno (spec 006).
        || (signedIn() && !isBlocked()
          && resource.data.clientId == request.auth.uid
          && resource.data.status in ['waiting_confirmation', 'confirmed']
          && resource.data.startTime > request.time + duration.value(editMarginMinutes(), 'm')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['startTime', 'endTime', 'booked', 'status'])
          && request.resource.data.status == 'waiting_confirmation'
          && request.resource.data.startTime > request.time
          && request.resource.data.endTime > request.resource.data.startTime
          && getAfter(/databases/$(database)/documents/busySlots/$(id)).data.start == request.resource.data.startTime
          && getAfter(/databases/$(database)/documents/busySlots/$(id)).data.end == request.resource.data.endTime)
        // La admin edita un turno activo (spec 008, RF-43).
        || (isAdmin()
          && resource.data.status in ['waiting_confirmation', 'confirmed']
          && resource.data.endTime > request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientId', 'clientName', 'clientPhone', 'clientPhotoUrl', 'startTime', 'endTime', 'booked', 'status', 'createdByAdmin'])
          && request.resource.data.status == 'confirmed'
          && request.resource.data.endTime > request.resource.data.startTime
          // Nunca quita la marca (RF-31).
          && (request.resource.data.get('createdByAdmin', false) == true
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdByAdmin']))
          // Si cambia la persona, lo marca como suyo (RF-31).
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['clientId', 'clientName', 'clientPhone', 'clientPhotoUrl'])
            || request.resource.data.get('createdByAdmin', false) == true)
          && (request.resource.data.clientId == null
            || (request.resource.data.clientId != request.auth.uid
              && get(/databases/$(database)/documents/users/$(request.resource.data.clientId)).data.role == 'cliente'
              && get(/databases/$(database)/documents/users/$(request.resource.data.clientId)).data.get('isBlocked', false) == false))
          && getAfter(/databases/$(database)/documents/busySlots/$(id)).data.start == request.resource.data.startTime
          && getAfter(/databases/$(database)/documents/busySlots/$(id)).data.end == request.resource.data.endTime)
        // La clienta cancela su turno (spec 009, RF-19).
        || (signedIn()
          && resource.data.clientId == request.auth.uid
          && resource.data.status in ['waiting_confirmation', 'confirmed']
          && resource.data.startTime > request.time + duration.value(editMarginMinutes(), 'm')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy'])
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledBy == 'client'
          && !existsAfter(/databases/$(database)/documents/busySlots/$(id)))
        // La clienta copia su WhatsApp (spec 009, RF-28).
        || (signedIn()
          && resource.data.clientId == request.auth.uid
          && resource.data.status in ['waiting_confirmation', 'confirmed']
          && resource.data.endTime > request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientPhone'])
          && request.resource.data.clientPhone == getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneNumber);
      allow delete: if false;
    }

    // Turnos ocupados: solo inicio y fin, con el mismo id que su turno. Los
    // lee cualquiera con sesión para ver las horas libres (RF-53); se crean
    // junto a un turno propio con las mismas horas, y la admin los borra al
    // cancelar (RF-56). Se cambian solo junto a la edición de su turno, que
    // es de la clienta, con sus mismas horas (spec 006, RF-24, RF-26). La
    // admin también los crea y los cambia junto a cualquier turno, con sus
    // mismas horas: el que agenda (spec 007, RF-25) y el que edita, que con
    // `set` crea el que le faltara a un turno antiguo (spec 008, RF-43).
    // La clienta borra el de su turno al cancelarlo, en el mismo lote
    // (spec 009, RF-19).
    match /busySlots/{id} {
      allow get, list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['start', 'end'])
        && (getAfter(/databases/$(database)/documents/appointments/$(id)).data.clientId == request.auth.uid
          || isAdmin())
        && getAfter(/databases/$(database)/documents/appointments/$(id)).data.startTime == request.resource.data.start
        && getAfter(/databases/$(database)/documents/appointments/$(id)).data.endTime == request.resource.data.end;
      allow delete: if isAdmin()
        || (signedIn()
          && get(/databases/$(database)/documents/appointments/$(id)).data.clientId == request.auth.uid
          && getAfter(/databases/$(database)/documents/appointments/$(id)).data.status == 'cancelled');
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['start', 'end'])
        && (get(/databases/$(database)/documents/appointments/$(id)).data.clientId == request.auth.uid
          || isAdmin())
        && getAfter(/databases/$(database)/documents/appointments/$(id)).data.startTime == request.resource.data.start
        && getAfter(/databases/$(database)/documents/appointments/$(id)).data.endTime == request.resource.data.end;
    }

    // Calendario del salón (spec 006, RF-25): lo lee cualquiera con sesión
    // y solo lo escribe la admin, también el margen de edición. El margen
    // solo se valida cuando cambia: uno guardado a mano como double no
    // impide guardar el horario (spec 008, RF-44, D-7).
    match /settings/calendar {
      allow read: if signedIn();
      allow create: if isAdmin() && validEditMargin();
      allow update: if isAdmin()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['editMarginMinutes'])
          || validEditMargin());
      allow delete: if isAdmin();
    }

    // Cierres de la agenda (spec 008, RF-42): los lee cualquiera con sesión
    // para no ofrecer sus horas; solo la admin los crea, con solo su inicio
    // y su fin, y los quita. No se cambian: se quitan y se crean otros.
    match /closures/{id} {
      allow get, list: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['start', 'end'])
        && request.resource.data.start is timestamp
        && request.resource.data.end is timestamp
        && request.resource.data.end > request.resource.data.start;
      allow delete: if isAdmin();
      allow update: if false;
    }
  }
}
